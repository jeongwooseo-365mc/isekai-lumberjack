{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "이세계로 소환되어버린 나무꾼",
  "version": "0.9.0",
  "identifier": "com.isekailumberjack.game",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "이세계로 소환되어버린 나무꾼",
        "width": 520,
        "height": 900,
        "minWidth": 390,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; img-src 'self' asset: data:; media-src 'self' asset:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
